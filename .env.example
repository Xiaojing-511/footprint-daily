# ===== ActivityWatch =====
AW_BASE_URL=http://localhost:5600
# 你所在时区相对 UTC 的小时偏移（中国 = 8）
TZ_OFFSET_HOURS=8

# ===== LLM（默认 DeepSeek，国内直连）=====
# 去 https://platform.deepseek.com 创建 API Key
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-在这里填你的key
LLM_MODEL=deepseek-chat
# 其他提供商示例：
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://你的网关/v1

# ===== Notion =====
# 1) https://www.notion.so/my-integrations 创建集成 → 复制 Internal Integration Token（secret_ 或 ntn_ 开头）
# 2) 在 Notion 建一个 Database → 右上角 ... → Connections → 邀请你的集成
# 3) 复制数据库页面 URL 中 /<32位hex>?v= 里的 32 位 hex（注意是 ?v= 前的 p/ 段，不是视图 id）
NOTION_TOKEN=ntn_或secret_在这里填你的token
NOTION_DATABASE_ID=在这里填你的database_id(32位hex)
